<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{% if title %}{{ title }} - {% endif %}{{ site.name }}</title>
  <meta name="description" content="{{ description or metadata.description }}">

  <!-- Apply saved light/dark theme before first paint -->
  <script>try{if(localStorage.getItem("theme")==="dark")document.documentElement.dataset.theme="dark"}catch(e){}</script>
  <script src="/assets/js/theme.js" defer></script>

  <!-- Fonts: Atkinson Hyperlegible Next + Mono -->
  <link rel="stylesheet" href="/assets/fonts/atkinson-next/index.css">
  <link rel="stylesheet" href="/assets/fonts/atkinson-mono/index.css">

  <!-- Pico.css -->
  <link rel="stylesheet" href="/assets/css/pico.css/style.css">

  <!-- Theme -->
  <link rel="stylesheet" href="/assets/css/style.css">

  <!-- Favicon -->
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
</head>
<body>

  {% include "components/header.njk" %}

  <main>
    {{ content | safe }}
  </main>

  {% include "components/footer.njk" %}

</body>
</html>
