<header class="site-header">
  <nav>
    <ul>
      <li>
        <a href="/" class="home-link" aria-label="{{ site.name }}, home">
          <strong class="home-text">{{ site.name }}</strong>
          <span class="home-frames" aria-hidden="true" style="--n: {{ homeArt.length }}">
            {%- for frame in homeArt %}
            <svg viewBox="0 0 {{ frame.width }} {{ frame.height }}" style="--i: {{ loop.index0 }}" focusable="false"><use href="/assets/home-art.svg#{{ frame.id }}" width="{{ frame.width }}" height="{{ frame.height }}"/></svg>
            {%- endfor %}
          </span>
        </a>
        <style>@keyframes home-cycle { 0% { visibility: visible; } {{ 100 / homeArt.length }}%, 100% { visibility: hidden; } }</style>
      </li>
    </ul>
    <ul>
      {% for item in nav %}
        <li>
          <a href="{{ item.url }}" class="nav-art" aria-label="{{ item.name }}"{% if page.url and page.url.startsWith(item.url) %} aria-current="page"{% endif %}>
            {{ navArt[item.name] | safe }}
          </a>
        </li>
      {% endfor %}
      <li>
        <button type="button" class="theme-toggle" hidden>{{ themeArt | safe }}</button>
      </li>
    </ul>
  </nav>
</header>
