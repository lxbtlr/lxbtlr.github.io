<header class="site-header">
  <nav>
    <ul>
      <li>
        <a href="/">
          <strong>{{ site.name }}</strong>
        </a>
      </li>
    </ul>
    <ul>
      {% for item in nav %}
        <li>
          <a href="{{ item.url }}" class="nav-art" aria-label="{{ item.name }}"{% if page.url and page.url.startsWith(item.url) %} aria-current="page"{% endif %}>
            {{ navArt[item.name] | safe }}
          </a>
        </li>
      {% endfor %}
      <li>
        <button type="button" class="theme-toggle" hidden>☀</button>
      </li>
    </ul>
  </nav>
</header>
