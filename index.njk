---
layout: layouts/base.njk
---

<div class="title-row" style="display: flex; align-items: left; gap: 5%;">
  <img src="/assets/images/me.png" alt="Photo of {{ site.name }}" class="home-photo"/>
  <hgroup class="title-card">
    <h1>{{ site.name }}</h1>
    <h5>{{ site.title }}</h5>
    <h5>{{ site.institution }}</h5>
    <div style="margin-top: 0.25rem;"></div>
    <h6>
      <a href="mailto:{{ site.email }}">{{ site.email }}</a>
    </h6>
    <div style="margin-top: 0.5rem;"></div>
    <h6>
      {{ site.office.room }}<br>
      {{ site.office.street }}<br>
      {{ site.office.city }}
    </h6>
    <div class="home-links">
      <a href="https://github.com/{{ site.github }}" target="_blank" aria-label="GitHub" title="GitHub">
        <svg viewBox="0 0 16 16" width="28" height="28" fill="currentColor" aria-hidden="true">
          <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"/>
        </svg>
      </a>
      <a href="/files/Alex_Butler_RESUME.pdf" target="_blank" aria-label="C/V" title="C/V">
        <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" aria-hidden="true">
          <path d="M6 2h8l5 5v15H6z"/>
          <path d="M14 2v5h5"/>
          <text x="12.5" y="17.5" text-anchor="middle" font-size="6" font-family="var(--font-family-mono-text), monospace" font-weight="700" fill="currentColor" stroke="none">CV</text>
        </svg>
      </a>
    </div>
  </hgroup>
</div>

<br>

<article class="home-bio">
  <p>
    I am a computer science PhD candidate at
    Northwestern University
    in Evanston, Illinois. I currently work in the {{ site.lab }} with Dr. <a href="http://www.pdinda.org/">Peter Dinda</a>.
    My research interests primarily lie in architecture-aware optimizations for parallel systems,
    with work ranging from synchronization primitives to wimpy-node/efficient computing clusters.
    My recent work focuses on low-level performance engineering for vectorized and compiled
    database execution engines, revisiting
    how the two compare on modern hardware when their
    micro-architecture bottlenecks are reconciled.
    {#- TODO: link /projects/databases/ here again once that page is listed. #}
  </p>
  <p>
    I earned my bachelor's degree in electrical &amp; computer engineering from
    <a href="https://www.olin.edu" target="_blank">Olin College of Engineering</a>,
    focusing on work in power electronics, software systems, and hardware design (ASICs to PCBs).
    From 2021&ndash;2025, I interned working on the IBM Z mainframes as a part of the Millicode and
    System Architecture teams. Most recently I worked on formalizing the z/Architecture memory model
    from its specifications.
  </p>
</article>
{#- The blog roll only shows once there is a published (non-draft) post;
    until then the news roll takes the full width. #}
{% set hasPosts = (collections.posts | published).length %}
<div class="rolls{% if not hasPosts %} rolls-single{% endif %}">
  <article>
    <h2>News</h2>

    <hr />

    <dl class="news-list">
      {% for item in news | sort("date") | reverse %}
      <dt><time datetime="{{ item.date }}">{{ item.date | dateFormat("MMM yyyy") }}</time></dt>
      <dd>{{ item.text }}</dd>
      {% endfor %}
    </dl>
  </article>

  {% if hasPosts %}
  <article>
    <h2>Blog</h2>

    <hr />

    {% set recentPosts = collections.posts | reverse | head(7) %}
    {% if recentPosts.length %}
    <dl class="news-list">
      {% for post in recentPosts %}
      <dt><time datetime="{{ post.date | dateFormat("yyyy-MM-dd") }}">{{ post.date | dateFormat("MMM yyyy") }}</time></dt>
      <dd>
        <a href="{{ post.url }}">{{ post.data.title }}</a>
        {%- if post.data.draft %} <mark>draft</mark>{% endif %}
      </dd>
      {% endfor %}
    </dl>
    <p><small><a href="/posts/">All posts &rarr;</a></small></p>
    {% else %}
    <p>No posts yet.</p>
    {% endif %}
  </article>
  {% endif %}
</div>

<article>
  <h2>Publications</h2>

  <hr />

  {% if publications.length %}
  <dl class="news-list">
    {% for pub in publications | sort("year") | reverse %}
    <dt>{{ pub.year }}</dt>
    <dd class="pub">
      <div>
        {% set link = pub.url or pub.pdf %}{% if link %}<a href="{{ link }}" target="_blank">{{ pub.title }}</a>{% else %}{{ pub.title }}{% endif %}
        <small class="pub-line">{{ pub.authors | replace("Alexander Butler", "<strong>Alexander Butler</strong>") | safe }}.</small>
        <small class="pub-line"><em>{{ pub.venue }}</em>.</small>
      </div>
      {% if pub.pdf %}
      <a href="{{ pub.pdf }}" target="_blank" class="pub-pdf" aria-label="PDF of {{ pub.title }}" title="PDF">
        <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" aria-hidden="true">
          <path d="M6 2h8l5 5v15H6z"/>
          <path d="M14 2v5h5"/>
          <text x="12.5" y="17.5" text-anchor="middle" font-size="5.5" font-family="var(--font-family-mono-text), monospace" font-weight="700" fill="currentColor" stroke="none">PDF</text>
        </svg>
      </a>
      {% endif %}
    </dd>
    {% endfor %}
  </dl>
  {% else %}
  <p>No publications yet.</p>
  {% endif %}
</article>
