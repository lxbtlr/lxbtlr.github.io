---
layout: layouts/page.njk
title: Projects
---

<br>

<div class="grid" style="grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));">

  {% for project in projects %}

  <article>
    <header>
      <center>
        <h3>
          <a href="{{ project.url }}" class="card-title">
            {{ project.name }}
          </a>
        </h3>

        {% if project.img %}
        <img src="{{ project.img }}" alt="{{ project.name }}" style="height: 120px; object-fit: contain;">
        {% endif %}
      </center>
    </header>

    <p>
      {{ project.desc }}
    </p>
  </article>

  {% endfor %}

</div>
