---
layout: layouts/base.njk
title: about me
---

<article class="cv">

<h1><center>{{ site.name }}</center></h1>

<center>
<a href="{{ site.cvPdf }}" download="Alex_Butler_CV.pdf">Download C/V</a>
</center>

<br>

<article>
<h2>Research Interests</h2>
<hr />
<p>{{ site.researchInterests }}</p>
</article>

<article>
<h2>Education</h2>
<hr />

{% for edu in education %}
<div class="logo-entry">
{% if edu.logo %}<img src="{{ edu.logo }}" alt="{{ edu.institution }} logo" class="entry-logo">{% endif %}
<p>
<b>{{ edu.institution }}</b>, <i>{{ edu.location }}</i>.

  {% for degree in edu.degrees %}
    <br>
    {{ degree.degree }} in {{ degree.major }}{%- if degree.advisor -%}, <i>Advised by {% if degree.advisorUrl %}<a href="{{ degree.advisorUrl }}">{{ degree.advisor }}</a>{% else %}{{ degree.advisor }}{% endif %}</i>{%- endif -%}. {{ degree.date }}.
  {% endfor %}
</p>
</div>


{% endfor %}
</article>

<article>
<h2>Experience</h2>
<hr />
{% for job in experience %}
<div class="logo-entry">
  {% if job.logo %}<img src="{{ job.logo }}" alt="{{ job.org }} logo" class="entry-logo">{% endif %}
  <div>
  <hgroup>
    <h5>{{ job.role }}</h5>
    <small>
      <i>{{ job.org }}</i>, {{ job.date }}.
    </small>
  </hgroup>
  {% if job.desc %}<p>{{ job.desc }}</p>{% endif %}
  </div>
</div>
{% endfor %}
</article>

<article>
<h2>Publications</h2>
<hr />
{% for pub in publications | sort("year") | reverse %}
  <hgroup>
    <h5>{% set link = pub.url or pub.pdf %}{% if link %}<a href="{{ link }}">{{ pub.title }}</a>{% else %}{{ pub.title }}{% endif %}</h5>
    <small>
      {{ pub.authors | replace("Alexander Butler", "<strong>Alexander Butler</strong>") | safe }}.<br>
      <i>{{ pub.venue }}</i>.
    </small>
  </hgroup>
{% else %}
  <p>No publications yet.</p>
{% endfor %}
</article>

<article>
<h2>Awards</h2>
<hr />
{#- Entries come from _data/awards.json: { "title", "org", "date" } #}
{% for award in awards %}
  <hgroup>
    <h5>{{ award.title }}</h5>
    <small><i>{{ award.org }}</i>, {{ award.date }}.</small>
  </hgroup>
{% endfor %}
</article>

<article>
<h2>Projects</h2>
<hr />
{% for project in projects | rejectattr("unlisted") | rejectattr("hideOnCv") %}
  <hgroup>
    <h5><a href="{{ project.url }}">{{ project.name }}</a></h5>
    <small>{{ project.desc }}</small>
  </hgroup>
  {#- role and skills come from _data/projects.json and show only here #}
  {% if project.role or project.skills %}
  <p class="project-meta">
    {% if project.role %}<i>{{ project.role }}</i>{% endif %}
    {#- a skill is a string, or { "text", "url" } to link it #}
    {% if project.skills %}<br><small>
      {%- for skill in project.skills -%}
        {%- if skill.url %}<a href="{{ skill.url }}">{{ skill.text }}</a>{% else %}{{ skill }}{% endif -%}
        {%- if not loop.last %} · {% endif -%}
      {%- endfor -%}
    </small>{% endif %}
  </p>
  {% endif %}
{% endfor %}
</article>

<article>
<h2>Service</h2>
<hr />
{#- Entries come from _data/service.json: { "role", "org", "date" } #}
{% for item in service %}
  <hgroup>
    <h5>{{ item.role }}</h5>
    <small><i>{{ item.org }}</i>, {{ item.date }}.</small>
  </hgroup>
{% else %}
  <p>TODO: add service entries to <code>_data/service.json</code>.</p>
{% endfor %}
</article>

</article>
